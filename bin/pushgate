#!/usr/bin/env python3
"""pushgate: Telonion's old name, kept so the hooks Push Gate wrote, and the people used to it, still run Telonion
(bin/telonion). Standard library only; Python 3.9 or later."""
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from telonion.cli import main  # noqa: E402

sys.exit(main(sys.argv[1:]))
